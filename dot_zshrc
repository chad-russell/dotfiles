# --- Path and fpath setup (optional, for plugin managers) ---
# If using a plugin manager, it will handle fpath. Otherwise, add plugin paths manually if needed.

# Add ~/.local/bin to PATH if it exists and is not already in PATH
if [ -d "$HOME/.local/bin" ] && [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# oh-my-posh
# Install from https://ohmyposh.dev/docs/installation
eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/config.json)"

# mise (shell integration)
if command -v mise >/dev/null; then
  eval "$(mise activate zsh)"
fi

# zoxide
# Install from https://github.com/ajeetdsouza/zoxide, managed by mise
eval "$(zoxide init zsh)"

# --- History Options ---
HISTSIZE="10000"
SAVEHIST="10000"
HISTFILE="$HOME/.zsh_history"
mkdir -p "$(dirname "$HISTFILE")"

setopt HIST_FCNTL_LOCK
unsetopt APPEND_HISTORY
setopt HIST_IGNORE_DUPS
unsetopt HIST_IGNORE_ALL_DUPS
unsetopt HIST_SAVE_NO_DUPS
unsetopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
unsetopt HIST_EXPIRE_DUPS_FIRST
setopt SHARE_HISTORY
unsetopt EXTENDED_HISTORY
setopt autocd

# --- Keybindings and Options ---
bindkey '^f' autosuggest-accept;
set -o vi;
bindkey '^P' up-line-or-search;
bindkey '^N' down-line-or-search;

# --- Functions ---
function mkcd {
    mkdir "$1";
    cd "$1";
}

function homeup {
    echo "Run your home-manager switch command here if needed."
}

function nixup {
    echo "Run your nixos-rebuild command here if needed."
}

function copy_caddy_config {
    scp root@reverse-proxy:Caddyfile ~/nix/Caddyfile
}

function killport {
    lsof -ti:"$1" | xargs kill -9
}

function ssh_reload {
    ssh-add ~/.ssh/id_rsa;
}

function nixedit {
    echo "Open your Nix config here if needed."
}

function browser-tools-helper {
    npx -y @agentdeskai/browser-tools-server@1.2.0
}

whichport() {
    sudo lsof -i -P | grep LISTEN | grep "$1"
}

# --- Aliases ---
alias pr='pnpm run'
alias ..='cd ..'
alias ...='cd ../..'
alias e='eza'
alias v='nvim'
alias vi='nvim'
alias vim='nvim'

# --- Plugin Initialization (uncomment as needed) ---
# Zinit will handle plugin loading if zinit.zsh is sourced correctly.

# --- Ghostty Integration (optional) ---
if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
  source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

# --- Zinit Plugin Manager Setup (manual installation) ---
# Zinit installation is handled by a run_once script.
# This section just sources it if available and declares plugins.

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Source Zinit if it has been installed
if [ -f "${ZINIT_HOME}/zinit.zsh" ]; then
  source "${ZINIT_HOME}/zinit.zsh"

  # Load Zinit plugins (will be installed by Zinit if missing on first run)
  # Using 'ice depth"1" lucid' for shallow clones and faster loading.
  # echo "Loading Zinit plugins..."
  zinit ice depth"1" lucid
  zinit light zsh-users/zsh-autosuggestions

  zinit ice depth"1" lucid
  zinit light zsh-users/zsh-syntax-highlighting
  
  zinit ice as"command" from"gh-r" bpick"atuin-*.tar.gz" mv"atuin*/atuin -> atuin" \
    atclone"./atuin init zsh > init.zsh; ./atuin gen-completions --shell zsh > _atuin" \
    atpull"%atclone" src"init.zsh"
  # echo "Zinit plugins loading requested."
else
  echo "WARNING: zinit.zsh not found at ${ZINIT_HOME}/zinit.zsh. Zinit plugins will not load."
fi